{
 "c": "H4",
 "rev": true,
 "lead": "Personal fragrance and its kit, organised as kind (olfactive family or format) → scent archetype → version (concentration, reformulation, batch) → detail, with house, perfumer and tradition registers.",
 "b": [
  {
   "m": "Concentration",
   "v": "body mist < eau fraîche < eau de cologne < eau de toilette < eau de parfum < parfum / extrait < attar (oil)",
   "w": "Standard perfumery naming; versions of one scent differ by concentration."
  },
  {
   "m": "Reformulation and batch",
   "v": "vintage original → reformulations → current batch (batch code)",
   "w": "Collectors compare vintages and batch codes; IFRA restrictions drive reformulation."
  },
  {
   "m": "Lineage",
   "v": "original → flanker → clone / dupe / inspired-by",
   "w": "Fragrantica organises flankers and community-linked clones under the original scent."
  }
 ],
 "depts": [
  {
   "n": "Perfume",
   "mode": "variety",
   "note": "Scent is the archetype; concentrations, reformulations and flankers are versions. House and perfumer facts go in the registers.",
   "b": [
    {
     "m": "Longevity and projection (sillage)",
     "v": "intimate → moderate → strong",
     "w": "Fragrantica community ratings and reviewer practice."
    },
    {
     "m": "Natural vs synthetic materials",
     "w": "Niche and artisan houses market naturals; most fine fragrance blends both."
    },
    {
     "m": "Authenticity",
     "w": "Batch codes, cellophane, cap and atomiser quality; counterfeits common for best-sellers."
    }
   ],
   "t": "Fragrance in an alcohol base sprayed on the skin, grouped by the fragrance wheel; a scent in oil, mist or wax → Oils, attars & body fragrance; a small vial or set → Samples, decants & sets.",
