  },
  {
   "n": "Oils, attars & body fragrance",
   "mode": "variety",
   "t": "Fragrance worn without an alcohol spray: oils and attars, mists, solid and hair scents; an alcohol perfume → Perfume.",
   "ax": "What carries the scent: an oil or attar, or a light spray, wax or applicator?",
   "s": [
    {
     "n": "Attar & traditional oils",
     "t": "Oil perfumes with no alcohol, from Kannauj attars to Taif rose and oud oil; a modern brand oil is the last kind.",
     "ax": "kinds by main material: flower distillates, rose, oud, musk, blends, then modern brand oils",
     "k": [
      {
       "n": "Attar (deg-bhapka distillate)",
       "a": "ittar · itr · Kannauj attar",
       "d": "Natural distillate of flowers, herbs, earth or spices captured in a sandalwood or paraffin base by deg-bhapka distillation, then aged; Kannauj holds a protected geographical indication (2014).",
       "s": "https://en.wikipedia.org/wiki/Kannauj",
       "x": [
        {
         "n": "Rooh gulab (rose attar)",
         "a": "gulab attar · ruh gulab · attar of roses",
         "d": "Damask rose petals distilled into sandalwood oil; the classic Kannauj rose attar, a cooling summer scent.",
