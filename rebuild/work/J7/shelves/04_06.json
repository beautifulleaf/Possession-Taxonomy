 "traditions": [
  {
   "n": "Traditional lambic and gueuze",
   "g": "Food & drink",
   "r": "Pajottenland and Senne valley, south-west of Brussels (Belgium)",
   "p": "13th century to present; gueuze EU TSG 1997/98",
   "d": "Spontaneously fermented wheat beer, aged in wood and blended into gueuze or refermented on fruit, guarded by the High Council for Artisanal Lambic Beers (HORAL).",
   "tech": "Wort cooled overnight in an open coolship, inoculated by airborne yeasts and bacteria, brewed October to May, aged in barrels with old dry hops, blended young with old",
   "mat": "Barley malt, unmalted wheat, aged hops, oak barrels, whole fruit (Schaarbeek cherries, raspberries)",
   "forms": [
    "Lambic",
    "Gueuze",
    "Fruit lambic"
   ],
   "ctr": [
    "Cantillon (Anderlecht)",
    "3 Fonteinen, Oud Beersel (Beersel)",
    "Boon (Lembeek)",
    "Lindemans (Vlezenbeek)",
    "Girardin (Sint-Ulriks-Kapelle)",
    "Hanssens (Dworp)",
    "De Cam (Gooik)",
    "Tilquin (Rebecq)"
   ],
   "auth": "'Oude Gueuze'/'Oude Geuze' and 'Oude Kriek' on the label mean unsweetened blends of 100% lambic; HORAL contested 'Méthode Gueuze' abroad (Jester King now uses 'Méthode Traditionnelle').",
   "s": "https://en.wikipedia.org/wiki/Gueuze"
  }
 ],
 "notes": "All eight planned kinds are new (no old data). Archetypes per brief: Cantillon, 3 Fonteinen, Boon, Oud Beersel across lambic/gueuze/fruit lambic; Rodenbach Grand Cru; Liefmans Goudenband; Berliner Kindl Weisse; Leipziger Gose (maker-free; HTML source for Bayerischer Bahnhof unavailable, so BJCP 23 cited); Russian River and Jester King. HORAL as tradition entry cited to the Gueuze article (horal.be returned 503). Left out: Ritterguts/Bayerischer Bahnhof brand entries and founding dates (no retrieved page), Boon framboise and Mariage Parfait year, Timmermans/Mort Subite/Belle-Vue brand entries (versions only), Allagash Coolship and other US spontaneous beers (not on retrieved pages). Faro kept as archetype under Lambic rather than its own kind."
}